generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  
}

enum ListingStatus {
  ACTIVE
  PAUSED
  DELETED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  DECLINED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  HOLD
  PAID
  FAILED
}

enum PricingUnit {
  HOUR
  DAY
  WEEK
  MONTH
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id                String           @id @default(uuid())
  email             String           @unique
  passwordHash      String
  firstName         String
  lastName          String
  phone             String?          @unique
  role              UserRole         @default(USER)
  acceptedTosId     String?
  acceptedTos       TermsOfService?  @relation("AcceptedTos", fields: [acceptedTosId], references: [id])
  createdTosVersions TermsOfService[] @relation("CreatedTos")
  tosAgreements     TosAgreement[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  sessions          Session[]
  listings          Listing[]
  renterBookings    Booking[]        @relation("Renter")
  ownerBookings     Booking[]        @relation("Owner")
  bookingIssues     BookingIssue[]

  @@map("users")
}

model Session {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  revokedAt       DateTime?
  userAgent       String?
  ip              String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@map("sessions")
}

model TermsOfService {
  id          String          @id @default(uuid())
  version               Int
  filePath              String
  checksum              String
  locale                String          @default("en")
  isActive              Boolean         @default(true)
  requiresReacceptance  Boolean         @default(false)
  createdById           String
  createdBy             User            @relation("CreatedTos", fields: [createdById], references: [id], onDelete: Cascade)
  acceptedByUsers       User[]          @relation("AcceptedTos")
  publishedAt DateTime        @default(now())
  agreements  TosAgreement[]

  @@unique([version, locale])
  @@index([version, locale])
  @@map("terms_of_service")
}

model TosAgreement {
  id           String          @id @default(uuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tosVersionId String
  tosVersion   TermsOfService  @relation(fields: [tosVersionId], references: [id], onDelete: Restrict)
  agreedAt     DateTime        @default(now())
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime        @default(now())

  @@index([userId])
  @@map("tos_agreements")
}

model Listing {
  id                 String    @id @default(uuid())
  ownerId            String
  owner              User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title              String
  description        String
  category           String
  city               String?
  latitude           Float
  longitude          Float
  address            String
  condition          String?
  tags               String[]
  images             String[]
  imageUrl           String?
  hourlyRate         Decimal?
  dailyRate          Decimal?
  weeklyRate         Decimal?
  status             ListingStatus @default(ACTIVE)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  availabilityBlocks AvailabilityBlock[]
  bookings           Booking[]

  @@index([ownerId])
  @@index([status])
  @@index([category])
  @@index([city])
  @@map("listings")
}

model AvailabilityBlock {
  id        String   @id @default(uuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  startAt   DateTime
  endAt     DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@index([listingId])
  @@index([startAt, endAt])
  @@map("availability_blocks")
}

model Booking {
  id               String        @id @default(uuid())
  listingId        String
  listing          Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  renterId         String
  renter           User          @relation("Renter", fields: [renterId], references: [id], onDelete: Cascade)
  ownerId          String
  owner            User          @relation("Owner", fields: [ownerId], references: [id], onDelete: Cascade)
  startAt          DateTime
  endAt            DateTime
  expiresAt        DateTime?
  status           BookingStatus @default(PENDING)
  paymentStatus    PaymentStatus @default(UNPAID)
  depositAmount    Decimal?
  paymentReference String?
  renterConfirmedAt DateTime?
  ownerConfirmedAt  DateTime?
  pricingUnit      PricingUnit
  quantity         Int
  unitRate         Decimal
  subtotal         Decimal
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  issues           BookingIssue[]

  @@index([listingId])
  @@index([renterId])
  @@index([ownerId])
  @@index([status])
  @@index([startAt, endAt])
  @@map("bookings")
}

model BookingIssue {
  id        String   @id @default(uuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  message   String
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId, createdAt])
  @@index([authorId])
  @@map("booking_issues")
}
